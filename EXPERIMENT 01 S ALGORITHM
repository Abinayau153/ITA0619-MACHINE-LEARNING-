        "# FIND-S ALGORITHM\n",
        "\n",
        "data = [\n",
        "    ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same', 'Yes'],\n",
        "    ['Sunny', 'Warm', 'High', 'Strong', 'Warm', 'Same', 'Yes'],\n",
        "    ['Rainy', 'Cold', 'High', 'Strong', 'Warm', 'Change', 'No'],\n",
        "    ['Sunny', 'Warm', 'High', 'Strong', 'Cool', 'Change', 'Yes']\n",
        "]\n",
        "\n",
        "h = ['0', '0', '0', '0', '0', '0']\n",
        "\n",
        "print(\"FIND-S ALGORITHM\")\n",
        "print(\"-----------------------------\")\n",
        "print(\"Initial Hypothesis:\", h)\n",
        "\n",
        "step = 1\n",
        "\n",
        "for row in data:\n",
        "\n",
        "    print(\"\\nStep\", step)\n",
        "    print(\"Training Example:\", row)\n",
        "\n",
        "    if row[-1] == 'Yes':\n",
        "\n",
        "        print(\"Class = Yes\")\n",
        "        print(\"Positive example found\")\n",
        "\n",
        "        for i in range(6):\n",
        "\n",
        "            if h[i] == '0':\n",
        "                h[i] = row[i]\n",
        "                print(\"Position\", i + 1, \"updated to\", h[i])\n",
        "\n",
        "            elif h[i] != row[i]:\n",
        "                h[i] = '?'\n",
        "                print(\"Position\", i + 1, \"has different value\")\n",
        "                print(\"Updated to ?\")\n",
        "\n",
        "        print(\"Hypothesis after this example:\", h)\n",
        "\n",
        "    else:\n",
        "        print(\"Class = No\")\n",
        "        print(\"Negative example ignored\")\n",
        "\n",
        "    step += 1\n",
        "\n",
        "print(\"\\n-----------------------------\")\n",
        "print(\"FINAL MOST SPECIFIC HYPOTHESIS\")\n",
        "print(h)"
      ]
    }
  ]
