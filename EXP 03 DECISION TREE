        "import math\n",
        "\n",
        "# Training data\n",
        "data = [\n",
        "    ['Sunny', 'Hot', 'High', 'Weak', 'No'],\n",
        "    ['Sunny', 'Hot', 'High', 'Strong', 'No'],\n",
        "    ['Overcast', 'Hot', 'High', 'Weak', 'Yes'],\n",
        "    ['Rain', 'Mild', 'High', 'Weak', 'Yes'],\n",
        "    ['Rain', 'Cool', 'Normal', 'Weak', 'Yes'],\n",
        "    ['Rain', 'Cool', 'Normal', 'Strong', 'No'],\n",
        "    ['Overcast', 'Cool', 'Normal', 'Strong', 'Yes'],\n",
        "    ['Sunny', 'Mild', 'High', 'Weak', 'No'],\n",
        "    ['Sunny', 'Cool', 'Normal', 'Weak', 'Yes'],\n",
        "    ['Rain', 'Mild', 'Normal', 'Weak', 'Yes'],\n",
        "    ['Sunny', 'Mild', 'Normal', 'Strong', 'Yes'],\n",
        "    ['Overcast', 'Mild', 'High', 'Strong', 'Yes'],\n",
        "    ['Overcast', 'Hot', 'Normal', 'Weak', 'Yes'],\n",
        "    ['Rain', 'Mild', 'High', 'Strong', 'No']\n",
        "]\n",
        "\n",
        "attributes = ['Outlook', 'Temperature', 'Humidity', 'Wind']\n",
        "\n",
        "\n",
        "# Calculate Entropy\n",
        "def entropy(data):\n",
        "\n",
        "    yes = 0\n",
        "    no = 0\n",
        "\n",
        "    for row in data:\n",
        "\n",
        "        if row[-1] == 'Yes':\n",
        "            yes = yes + 1\n",
        "        else:\n",
        "            no = no + 1\n",
        "\n",
        "    total = yes + no\n",
        "\n",
        "    result = 0\n",
        "\n",
        "    if yes > 0:\n",
        "        p = yes / total\n",
        "        result = result - p * math.log2(p)\n",
        "\n",
        "    if no > 0:\n",
        "        p = no / total\n",
        "        result = result - p * math.log2(p)\n",
        "\n",
        "    return result\n",
        "\n",
        "\n",
        "# Calculate Information Gain\n",
        "def information_gain(data, index):\n",
        "\n",
        "    total_entropy = entropy(data)\n",
        "\n",
        "    values = []\n",
        "\n",
        "    for row in data:\n",
        "\n",
        "        if row[index] not in values:\n",
        "            values.append(row[index])\n",
        "\n",
        "    weighted_entropy = 0\n",
        "\n",
        "    for value in values:\n",
        "\n",
        "        subset = []\n",
        "\n",
        "        for row in data:\n",
        "\n",
        "            if row[index] == value:\n",
        "                subset.append(row)\n",
        "\n",
        "        weighted_entropy = weighted_entropy + (\n",
        "            len(subset) / len(data)\n",
        "        ) * entropy(subset)\n",
        "\n",
        "    gain = total_entropy - weighted_entropy\n",
        "\n",
        "    return gain\n",
        "\n",
        "\n",
        "# Start\n",
        "print(\"ID3 DECISION TREE ALGORITHM\")\n",
        "print(\"============================\")\n",
        "\n",
        "print(\"\\nSTEP 1: Training Data\")\n",
        "print(\"---------------------\")\n",
        "\n",
        "for row in data:\n",
        "    print(row)\n",
        "\n",
        "\n",
        "# Entropy\n",
        "print(\"\\nSTEP 2: Calculate Entropy\")\n",
        "print(\"-------------------------\")\n",
        "\n",
        "total_entropy = entropy(data)\n",
        "\n",
        "print(\"Entropy =\", round(total_entropy, 4))\n",
        "\n",
        "\n",
        "# Information Gain\n",
        "print(\"\\nSTEP 3: Calculate Information Gain\")\n",
        "print(\"-----------------------------------\")\n",
        "\n",
        "gains = []\n",
        "\n",
        "for i in range(len(attributes)):\n",
        "\n",
        "    gain = information_gain(data, i)\n",
        "\n",
        "    gains.append(gain)\n",
        "\n",
        "    print(attributes[i], \"=\", round(gain, 4))\n",
        "\n",
        "\n",
        "# Select root\n",
        "print(\"\\nSTEP 4: Select Root Node\")\n",
        "print(\"------------------------\")\n",
        "\n",
        "best_index = gains.index(max(gains))\n",
        "\n",
        "root = attributes[best_index]\n",
        "\n",
        "print(\"Highest Information Gain =\", round(max(gains), 4))\n",
        "print(\"Root Node =\", root)\n",
        "\n",
        "\n",
        "# Decision Tree\n",
        "print(\"\\nSTEP 5: Decision Tree\")\n",
        "print(\"---------------------\")\n",
        "\n",
        "print()\n",
        "print(\"              Outlook\")\n",
        "print(\"           /     |      \\\\\")\n",
        "print(\"       Sunny  Overcast   Rain\")\n",
