        "import csv\n",
        "\n",
        "# STEP 1: Create the CSV file\n",
        "\n",
        "data = [\n",
        "    ['Sky', 'AirTemp', 'Humidity', 'Wind', 'Water', 'Forecast', 'EnjoySport'],\n",
        "    ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same', 'Yes'],\n",
        "    ['Sunny', 'Warm', 'High', 'Strong', 'Warm', 'Same', 'Yes'],\n",
        "    ['Rainy', 'Cold', 'High', 'Strong', 'Warm', 'Change', 'No'],\n",
        "    ['Sunny', 'Warm', 'High', 'Strong', 'Cool', 'Change', 'Yes']\n",
        "]\n",
        "\n",
        "with open(\"trainingdata.csv\", \"w\", newline=\"\") as file:\n",
        "    writer = csv.writer(file)\n",
        "    writer.writerows(data)\n",
        "\n",
        "print(\"CSV file created successfully.\")\n",
        "\n",
        "# STEP 2: Read the CSV file\n",
        "\n",
        "with open(\"trainingdata.csv\", \"r\") as file:\n",
        "    reader = csv.reader(file)\n",
        "    data = list(reader)\n",
        "\n",
        "header = data[0]\n",
        "data = data[1:]\n",
        "\n",
        "print(\"\\nCANDIDATE-ELIMINATION ALGORITHM\")\n",
        "print(\"--------------------------------\")\n",
        "\n",
        "print(\"\\nAttributes:\")\n",
        "print(header[:-1])\n",
        "\n",
        "# STEP 3: Initialize S and G\n",
        "\n",
        "n = len(header) - 1\n",
        "\n",
        "S = ['0'] * n\n",
        "G = [['?'] * n]\n",
        "\n",
        "print(\"\\nInitial Specific Boundary S:\")\n",
        "print(S)\n",
        "\n",
        "print(\"\\nInitial General Boundary G:\")\n",
        "print(G)\n",
        "\n",
        "# Function to check hypothesis\n",
        "\n",
        "def covers(h, example):\n",
        "\n",
        "    for i in range(n):\n",
        "\n",
        "        if h[i] != '?' and h[i] != example[i]:\n",
        "            return False\n",
        "\n",
        "    return True\n",
        "\n",
        "\n",
        "# STEP 4: Process training examples\n",
        "\n",
        "step = 1\n",
        "\n",
        "for row in data:\n",
        "\n",
        "    example = row[:-1]\n",
        "    target = row[-1]\n",
        "\n",
        "    print(\"\\n================================\")\n",
        "    print(\"STEP\", step)\n",
        "    print(\"================================\")\n",
        "\n",
        "    print(\"Example:\", example)\n",
        "    print(\"Class:\", target)\n",
        "\n",
        "    # POSITIVE EXAMPLE\n",
        "\n",
        "    if target == \"Yes\":\n",
        "\n",
        "        print(\"\\nPositive Example\")\n",
        "        print(\"Updating Specific Boundary S\")\n",
        "\n",
        "        # Update S\n",
        "\n",
        "        for i in range(n):\n",
        "\n",
        "            if S[i] == '0':\n",
        "\n",
        "                S[i] = example[i]\n",
        "\n",
        "            elif S[i] != example[i]:\n",
        "\n",
        "                S[i] = '?'\n",
        "\n",
        "        # Remove G hypotheses that do not cover positive example\n",
        "\n",
        "        new_G = []\n",
        "\n",
        "        for g in G:\n",
        "\n",
        "            if covers(g, example):\n",
        "\n",
        "                new_G.append(g)\n",
        "\n",
        "        G = new_G\n",
        "\n",
        "        print(\"\\nUpdated S:\")\n",
        "        print(S)\n",
        "\n",
        "        print(\"\\nUpdated G:\")\n",
        "\n",
        "        for g in G:\n",
        "            print(g)\n",
        "\n",
        "    # NEGATIVE EXAMPLE\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(\"\\nNegative Example\")\n",
        "        print(\"Updating General Boundary G\")\n",
        "\n",
        "        new_G = []\n",
        "\n",
        "        for g in G:\n",
        "\n",
        "            if covers(g, example):\n",
        "\n",
        "                for i in range(n):\n",
        "\n",
        "                    if g[i] == '?' and S[i] != '0' and S[i] != '?':\n",
        "\n",
        "                        new_h = g.copy()\n",
        "\n",
        "                        new_h[i] = S[i]\n",
        "\n",
        "                        if not covers(new_h, example):\n",
        "\n",
        "                            if new_h not in new_G:\n",
        "\n",
        "                                new_G.append(new_h)\n",
        "\n",
        "            else:\n",
        "\n",
        "                new_G.append(g)\n",
        "\n",
        "        G = new_G\n",
        "\n",
        "        print(\"\\nS remains:\")\n",
        "        print(S)\n",
        "\n",
        "        print(\"\\nUpdated G:\")\n",
        "\n",
        "        for g in G:\n",
        "            print(g)\n",
        "\n",
        "    step = step + 1\n",
        "\n",
        "\n",
        "# STEP 5: Final result\n",
        "\n",
        "print(\"\\n================================\")\n",
        "print(\"FINAL RESULT\")\n",
        "print(\"================================\")\n",
        "\n",
        "print(\"\\nSpecific Boundary S:\")\n",
        "print(S)\n",
        "\n",
        "print(\"\\nGeneral Boundary G:\")\n",
        "\n",
        "for g in G:\n",
        "    print(g)"
